# Gemini API key — free tier, no credit card. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SQLite by default; swap to a Postgres URL to move off SQLite without
# touching app/models.py or the routers (see app/database.py).
DATABASE_URL=sqlite:///./data/app.db

# Vision + embedding models. Overridable in case Google renames or retires
# a free-tier model — app/vision.py falls back to the second model automatically.
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL_FALLBACK=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Mismatch guard thresholds — tune these against data/eval_set.json and
# defend the chosen numbers at the demo (see app/guard.py).
MISMATCH_SIMILARITY_THRESHOLD=0.55
MISMATCH_CONFIDENCE_THRESHOLD=0.5